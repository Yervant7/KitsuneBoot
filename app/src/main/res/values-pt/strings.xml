    <!-- Warnings -->
    <string name="warning_bootloop_title">Risco de Bootloop</string>
    <string name="warning_bootloop_message">A instalação de módulos ou boot animations personalizadas pode causar bootloop, especialmente se os parâmetros (resolução, formato ou taxa de quadros) forem configurados incorretamente ou de forma incompatível com o aparelho. Tenha sempre um método de recuperação ou modo de segurança acessível.</string>
    <string name="warning_oom_dialog_title">Aviso: Risco de Falta de Memória (OOM >90MB)</string>
    <string name="warning_oom_dialog_message">O arquivo bootanimation.zip gerado possui %1$.1f MB. Arquivos com mais de 90 MB podem causar problemas de falta de memória (Out Of Memory - OOM) e travamentos/bootloop durante a inicialização do Android. Recomendamos utilizar o formato JPEG ou reduzir a resolução caso enfrente problemas no boot.</string>
    <string name="warning_oom_estimated_hint">Tamanho elevado (>90MB estimado). Pode causar erro de OOM no boot. Considere usar JPEG.</string>
    <string name="inspector_oom_warning">Aviso: O arquivo ultrapassa 90 MB (%1$.1f MB) e pode causar erro de OOM durante o boot!</string>
    <string name="dismiss_warning_button">Entendi</string>

