    <!-- Warnings -->
    <string name="warning_bootloop_title">Bootloop Risk Warning</string>
    <string name="warning_bootloop_message">Installing root modules or custom boot animations can cause a bootloop, especially if parameters (resolution, format, or frame rate) are configured incorrectly or incompatibly with your device. Ensure you have recovery access or safe mode enabled.</string>
    <string name="warning_oom_dialog_title">OOM Risk Warning (>90MB)</string>
    <string name="warning_oom_dialog_message">The generated bootanimation.zip is %1$.1f MB. Archives larger than 90 MB may cause Out Of Memory (OOM) crashes and bootloops during Android boot. We recommend using JPEG format or lowering the resolution if your device experiences boot issues.</string>
    <string name="warning_oom_estimated_hint">High file size (>90MB estimated). May cause Out Of Memory (OOM) errors during boot. Consider using JPEG format.</string>
    <string name="inspector_oom_warning">Warning: Archive exceeds 90 MB (%1$.1f MB). High risk of OOM during boot!</string>
